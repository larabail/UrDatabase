<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UrDatabase.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Merged into the application scope so every window resolves the same
                     brush, rather than each window declaring its own copy of #EAEAEA and
                     the three drifting apart, which is what happened before. -->
                <ResourceInclude Source="avares://UrDatabase.App/Styles/Tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://UrDatabase.App/Styles/Theme.axaml"/>
    </Application.Styles>
</Application>
