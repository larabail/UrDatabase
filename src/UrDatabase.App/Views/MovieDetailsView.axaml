<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UrDatabase.Models"
             xmlns:ctrls="clr-namespace:UrDatabase.Controls"
             x:Class="UrDatabase.Views.MovieDetailsView">

    <!--
        Details, in place, across the whole window.

        This used to be a 1000x640 dialog over the library. A backdrop is a
        16:9 photograph and that window gave it about a third of the screen,
        which is the one thing this screen has that the library does not. It is
        now a sibling of the library inside MainWindow, so the backdrop gets
        the full 1400x900 and there is no second window to position, own or
        lose behind the first.
    -->

    <UserControl.Styles>
        <!-- The plot scroller's last line, cut in half, reads as a rendering
             fault rather than as "there is more below". A hairline directly
             under it turns the cut into an edge. -->
        <Style Selector="TextBlock.castName">
            <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style Selector="TextBlock.castRole">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
    </UserControl.Styles>

    <!-- Opaque, and deliberately so. Every layer above this one is
         semi-transparent, so without a solid base the library composites
         straight through the backdrop: its shelves, its genre row and its
         counts were all legible through the dark half of this screen. -->
    <Grid Background="{StaticResource RoomBrush}">
        <!-- The backdrop. No blur anywhere: Avalonia has no per-element filter
             and does not need one here. If a soft backdrop is ever wanted, it
             gets blurred once when it is cached to disk, not on every frame.

             Full opacity: the two gradients below do all the darkening, and
             they were designed against an undimmed photograph. Dimming the
             image as well was a third veil that only made the picture side of
             the screen muddy. -->
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"/>

        <!-- Darkens towards the foot, so the action bar has something to sit
             on whatever the photograph happens to be doing down there. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#4D0B0A09" Offset="0"/>
                    <GradientStop Color="#B80B0A09" Offset="0.58"/>
                    <GradientStop Color="#F70B0A09" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- The important one, and the reason the right half of this screen is
             not "empty". A backdrop is 16:9 and the text sits on the left third
             of it, so the readable side is darkened hard and the picture side
             is left alone. Darkening evenly instead gives you either unreadable
             prose or a grey rectangle that was visibly once a photograph. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FF0B0A09" Offset="0"/>
                    <GradientStop Color="#E60B0A09" Offset="0.30"/>
                    <GradientStop Color="#4D0B0A09" Offset="0.66"/>
                    <GradientStop Color="#1F0B0A09" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <DockPanel>

            <!-- Back, top left, where the eye already is. Escape does the same
                 thing and the button says so. -->
            <Border DockPanel.Dock="Top" Height="48" Padding="24,0">
                <Button x:Name="BackButton"
                        Classes="ghost"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="Back_Click"
                        ToolTip.Tip="Esc">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="←" FontSize="13"/>
                        <TextBlock Text="Library"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- The action bar is docked, so Play is in the same place on every
                 film regardless of how long the plot ran. -->
            <Border DockPanel.Dock="Bottom"
                    Padding="24,12,48,12"
                    Background="#B80B0A09"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,16,*">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <Button x:Name="PlayBtn"
                                Classes="primary"
                                Content="▶  Play"
                                Click="PlayBtn_Click"/>
                        <Button x:Name="LinkFileButton"
                                Classes="ghost"
                                Height="34"
                                Content="Link File…"
                                Click="LinkFile_Click"/>
                        <!-- The way out of a wrong TMDB match. Hidden for a server
                             film, which the server describes and the catalogue does
                             not own, so there is nothing here to correct. -->
                        <Button x:Name="CorrectMatchButton"
                                Classes="ghost"
                                Height="34"
                                Content="Wrong film?"
                                Click="CorrectMatch_Click"/>
                        <!-- Keeps a copy on this disk so the film survives being away
                             from the server. Shown only for a server film that is not
                             already here. -->
                        <Button x:Name="DownloadButton"
                                Classes="ghost"
                                Height="34"
                                Content="Download"
                                IsVisible="False"
                                Click="Download_Click"/>
                        <ProgressBar x:Name="DownloadProgress"
                                     Width="120"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="1"
                                     VerticalAlignment="Center"
                                     IsVisible="False"/>
                        <!-- The other direction: puts a film from this disk onto the
                             server, which Jellyfin's own API cannot be asked to do.
                             Shown only for a local film with a file behind it, and
                             only when an SFTP account is configured. -->
                        <Button x:Name="UploadButton"
                                Classes="ghost"
                                Height="34"
                                Content="Upload to Jellyfin"
                                IsVisible="False"
                                Click="Upload_Click"/>
                        <ProgressBar x:Name="UploadProgress"
                                     Width="120"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="1"
                                     VerticalAlignment="Center"
                                     IsVisible="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock x:Name="FileNote"
                                   Classes="mono"
                                   FontSize="10.5"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   MaxWidth="660"/>
                        <!-- Attribution required by the TMDB API terms, with OMDb
                             credited as the rating source. A film from a server was
                             described by the server, so TMDB is not credited for
                             work it did not do. -->
                        <TextBlock x:Name="AttributionText"
                                   Classes="attribution"
                                   TextAlignment="Right"
                                   MaxWidth="660"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Poster and text. -->
            <Grid Margin="24,8,48,0" ColumnDefinitions="250,48,*">

                <!-- A grid rather than a stack, for the reason the series screen's
                     column is one: a StackPanel measures against infinite height,
                     so a film with seven nominations asked for a 375-pixel poster
                     and roughly 400 pixels of Academy underneath it whether the
                     window had the room or not, and drew the remainder over the
                     footer. The poster is pinned; the Academy takes what is left. -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <Border x:Name="PosterPlate"
                            Grid.Row="0"
                            Width="250"
                            Height="375"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource RadiusLarge}"
                            ClipToBounds="True"
                            BoxShadow="0 18 42 0 #800B0A09">
                        <Grid>
                            <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                            <Border CornerRadius="{StaticResource RadiusLarge}"
                                    BorderBrush="{StaticResource EdgeBrush}"
                                    BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <!--
                        The Academy, under the poster, in the column that was otherwise 375
                        pixels of picture over 400 of nothing.

                        Hidden outright for the great majority of films, which were never
                        nominated for anything. An empty "ACADEMY AWARDS" heading would be the
                        app telling every user that something failed to load.

                        Wins and nominations are told apart by a glyph and by weight, not by
                        colour — the same rule the connection indicators follow, and for the
                        same reason.
                    -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  Padding="0,0,12,0"
                                  Margin="0,0,0,16">
                        <StackPanel x:Name="AwardsPanel"
                                    Margin="0,22,0,0"
                                    IsVisible="False">
                            <TextBlock x:Name="AwardsHeading"
                                       Classes="label"
                                       Text="ACADEMY AWARDS"
                                       LetterSpacing="1.6"
                                       Margin="0,0,0,5"/>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="AwardsSummary"
                                       Classes="mono"
                                       FontSize="11.5"
                                       Foreground="{StaticResource ProseBrush}"
                                       Margin="0,0,0,9"/>
                            <ItemsControl x:Name="AwardsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:AwardRow">
                                        <Grid ColumnDefinitions="15,*" Margin="0,0,0,7"
                                              ToolTip.Tip="{Binding Tip}">
                                            <TextBlock Grid.Column="0"
                                                       Classes="awardMark"
                                                       Classes.won="{Binding Won}"
                                                       Text="{Binding Mark}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="awardCategory"
                                                           Classes.won="{Binding Won}"
                                                           Text="{Binding Category}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Classes="awardDetail"
                                                           Text="{Binding Detail}"
                                                           IsVisible="{Binding HasDetail}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AwardsMore"
                                       Classes="dim"
                                       FontSize="11"
                                       IsVisible="False"
                                       Margin="15,1,0,0"/>
                            <TextBlock x:Name="AwardsAttribution"
                                       Classes="attribution"
                                       Margin="0,10,0,0"
                                       Text="Academy Awards data from the UrActor API."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- The plot takes the space that is left and scrolls inside
                     it; the credits are pinned to the foot of the column. A
                     fixed-height plot instead slices the last line in half on a
                     long one and leaves a quarter of the window dead under the
                     credits on a short one, which is the worst of both. -->
                <Grid Grid.Column="2"
                      RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                    <TextBlock Grid.Row="0"
                               x:Name="TitleText"
                               Classes="display"
                               FontSize="46"
                               LineHeight="48"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,12"/>

                    <!-- Each number under its own source's name, then what is known about the
                         copy itself as badges beside them. One row, because they answer one
                         question between them — is this the film I want, in the form I want it.

                         A WrapPanel rather than a StackPanel: a server film with eight audio
                         languages produces a long row, and the alternative to wrapping is
                         pushing the ratings off the side of the window. -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                        <ItemsControl x:Name="FactsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:DetailFact">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Classes="label"
                                                       Text="{Binding Label}"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Classes="factValue"
                                                       Classes.imdb="{Binding IsImdb}"
                                                       Classes.server="{Binding IsServer}"
                                                       Text="{Binding Value}"/>
                                        </StackPanel>
                                        <Rectangle Width="1"
                                                   Fill="{StaticResource EdgeBrush}"
                                                   Margin="0,0,16,0"
                                                   IsVisible="{Binding ShowSeparator}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom-aligned so the chips sit on the same line as the fact values
                             above their labels, not floating halfway up the row. -->
                        <ItemsControl x:Name="FlagsList" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:MediaFlag">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="label"
                                                   Text="{Binding GroupLabel}"
                                                   IsVisible="{Binding HasGroupLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,7,5"/>
                                        <Border Classes="flag"
                                                Classes.lang="{Binding IsLanguage}"
                                                Classes.sub="{Binding IsSubtitle}"
                                                ToolTip.Tip="{Binding Tip}">
                                            <TextBlock Classes="flagText" Text="{Binding Text}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <TextBlock Grid.Row="2"
                               x:Name="GenresText"
                               Classes="mono"
                               FontSize="11"
                               LetterSpacing="1.1"
                               Foreground="{StaticResource ProseBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Border x:Name="PlotPane"
                            Grid.Row="3"
                            BorderBrush="{StaticResource EdgeBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,12">
                        <!-- Transparent so the wheel has something to land on:
                             a long plot could not otherwise be scrolled except
                             with the cursor exactly over its text. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      Padding="0,0,16,0">
                            <TextBlock x:Name="OverviewText"
                                       Classes="body"
                                       MaxWidth="680"
                                       HorizontalAlignment="Left"/>
                        </ScrollViewer>
                    </Border>

                    <!--
                        What to put on next, and the answer is always something
                        already owned. This row is where a series lists its
                        episodes; a film has no episodes, and what it had
                        instead was several hundred pixels of backdrop nobody
                        was reading.

                        Every poster here is a film in this library, so every
                        one of them plays. A shelf of things TMDB recommends
                        that the user does not own would be an advertisement
                        rather than a library, which is why the recommendation
                        supplies only the ordering — see RelatedFilms.

                        Hidden entirely when it is empty, and the plot takes the
                        space back. A heading over an empty row is the app
                        reporting a failure it did not have.
                    -->
                    <StackPanel x:Name="RelatedPane"
                                Grid.Row="4"
                                Margin="0,16,0,0"
                                VerticalAlignment="Center"
                                IsVisible="False">
                        <TextBlock x:Name="RelatedHeading"
                                   Classes="label"
                                   LetterSpacing="1.6"
                                   Margin="0,0,0,5"/>
                        <Rectangle Height="1"
                                   Fill="{StaticResource EdgeBrush}"
                                   Margin="0,0,0,10"/>
                        <ScrollViewer Classes="shelf" Padding="0,0,0,4">
                            <ItemsControl x:Name="RelatedList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:UiMovie">
                                        <!-- The library's own card, at the library's own size and
                                             with no caption under it. Deliberately identical: a
                                             film is recognised by its poster here exactly as it is
                                             two clicks away, and the title it would carry
                                             underneath is already printed on the plate of any film
                                             whose artwork has not arrived yet. -->
                                        <StackPanel Classes="card"
                                                    Width="152"
                                                    Margin="0,0,14,0"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    PointerPressed="RelatedCard_Click"
                                                    ToolTip.Tip="{Binding Title}">
                                            <Grid>
                                                <ctrls:PosterCard SourcePath="{Binding DisplayPosterPath}"
                                                                  Title="{Binding Title}"
                                                                  Year="{Binding Year}"/>
                                                <Border Classes="ring"
                                                        CornerRadius="{StaticResource PosterRadius}"
                                                        BorderThickness="1"
                                                        BorderBrush="Transparent"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Grid.Row="5"
                          ColumnDefinitions="*,48,260"
                          Margin="0,24,0,24">

                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="label"
                                       Text="CAST"
                                       LetterSpacing="1.6"
                                       Margin="0,0,0,5"/>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,8"/>
                            <!-- A two-column list of name over character, not a
                                 row of chips. A chip reading "Keir Dullea as
                                 Dave Bowman" is a chip nobody can scan, and ten
                                 of them in a horizontal scroller is a list you
                                 have to drag to read. -->
                            <ItemsControl x:Name="CastList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" MaxHeight="120"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:CreditEntry">
                                        <StackPanel Width="230" Margin="0,0,24,4">
                                            <TextBlock Classes="castName"
                                                       Text="{Binding Primary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Classes="castRole"
                                                       Text="{Binding Secondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding HasSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoCastText"
                                       Classes="dim"
                                       IsVisible="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label"
                                       Text="CREW"
                                       LetterSpacing="1.6"
                                       Margin="0,0,0,5"/>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,8"/>
                            <!-- The same 120 pixels the cast beside it is held to,
                                 so the two halves of the credits end on one line
                                 rather than one of them running on past the other
                                 and out through the footer. Six crew wrapping onto
                                 two lines each is the case that overruns it, and it
                                 scrolls rather than being cut off. -->
                            <ScrollViewer MaxHeight="120"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"
                                          Padding="0,0,12,0">
                                <ItemsControl x:Name="CrewList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:CreditEntry">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Classes="label"
                                                           Text="{Binding Secondary}"
                                                           Width="62"
                                                           IsVisible="{Binding HasSecondary}"/>
                                                <TextBlock Classes="castName"
                                                           Text="{Binding Primary}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoCrewText"
                                       Classes="dim"
                                       IsVisible="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
