<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UrDatabase.Models"
             xmlns:ctrls="clr-namespace:UrDatabase.Controls"
             x:Class="UrDatabase.Views.MovieDetailsView">

    <!--
        Details, in place, across the whole window.

        This used to be a 1000x640 dialog over the library. A backdrop is a
        16:9 photograph and that window gave it about a third of the screen,
        which is the one thing this screen has that the library does not. It is
        now a sibling of the library inside MainWindow, so the backdrop gets
        the full 1400x900 and there is no second window to position, own or
        lose behind the first.
    -->

    <UserControl.Styles>
        <!-- The plot scroller's last line, cut in half, reads as a rendering
             fault rather than as "there is more below". A hairline directly
             under it turns the cut into an edge. -->
        <Style Selector="TextBlock.castName">
            <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style Selector="TextBlock.castRole">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <!-- Ten stars in a 250-pixel column, so no chrome at all: a lit star is
             brass, an unlit one is the dim ink every other secondary mark here
             uses. Hover previews in the hover brass without committing. -->
        <Style Selector="Button.star">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.star /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.star.lit">
            <Setter Property="Foreground" Value="{DynamicResource BrassBrush}"/>
        </Style>
        <Style Selector="Button.star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrassHoverBrush}"/>
        </Style>
        <Style Selector="Button.star:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- A person you have watched with before. Outlined when not in the
             line, brass when they are, which is the same on/off language the
             stars use. -->
        <Style Selector="ToggleButton.companion">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ProseBrush}"/>
        </Style>
        <Style Selector="ToggleButton.companion /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.companion:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrassHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
        </Style>
        <Style Selector="ToggleButton.companion:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrassBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrassBrush}"/>
        </Style>

        <!-- The brass ring a poster card wears under the pointer, so a still
             reads as something to click in the same way. -->
        <Style Selector="Border.still">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.still:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrassBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Opaque, and deliberately so. Every layer above this one is
         semi-transparent, so without a solid base the library composites
         straight through the backdrop: its shelves, its genre row and its
         counts were all legible through the dark half of this screen. -->
    <Grid Background="{StaticResource RoomBrush}">
        <!-- The backdrop. No blur anywhere: Avalonia has no per-element filter
             and does not need one here. If a soft backdrop is ever wanted, it
             gets blurred once when it is cached to disk, not on every frame.

             Full opacity: the two gradients below do all the darkening, and
             they were designed against an undimmed photograph. Dimming the
             image as well was a third veil that only made the picture side of
             the screen muddy. -->
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"/>

        <!-- Darkens towards the foot, so the action bar has something to sit
             on whatever the photograph happens to be doing down there. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#4D0B0A09" Offset="0"/>
                    <GradientStop Color="#B80B0A09" Offset="0.58"/>
                    <GradientStop Color="#F70B0A09" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- The important one, and the reason the right half of this screen is
             not "empty". A backdrop is 16:9 and the text sits on the left third
             of it, so the readable side is darkened hard and the picture side
             is left alone. Darkening evenly instead gives you either unreadable
             prose or a grey rectangle that was visibly once a photograph. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FF0B0A09" Offset="0"/>
                    <GradientStop Color="#E60B0A09" Offset="0.30"/>
                    <GradientStop Color="#4D0B0A09" Offset="0.66"/>
                    <GradientStop Color="#1F0B0A09" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <DockPanel>

            <!-- Back, top left, where the eye already is. Escape does the same
                 thing and the button says so. -->
            <Border DockPanel.Dock="Top" MinHeight="48" Padding="24,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button x:Name="BackButton"
                        Classes="ghost"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="Back_Click"
                        ToolTip.Tip="Esc">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="←" FontSize="13"/>
                        <TextBlock Text="Library"/>
                    </StackPanel>
                    </Button>
                    <TextBlock x:Name="RefreshStatus"
                               Grid.Column="1"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DimBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Classes="ghost"
                            Content="Refresh"
                            VerticalAlignment="Center"
                            Click="Refresh_Click"
                            ToolTip.Tip="Reload this movie and retry artwork. Does not scan folders."/>
                </Grid>
            </Border>

            <TextBlock x:Name="LoadNotice"
                       DockPanel.Dock="Top"
                       Margin="24,0,48,8"
                       Foreground="{DynamicResource DimBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>

            <!-- The action bar is docked, so Play is in the same place on every
                 film regardless of how long the plot ran. -->
            <Border DockPanel.Dock="Bottom"
                    Padding="24,12,48,12"
                    Background="#B80B0A09"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,16,*">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <Button x:Name="PlayBtn"
                                Classes="primary"
                                Content="▶  Play"
                                Click="PlayBtn_Click"/>
                        <!-- Only on a film that will genuinely be resumed, because
                             it is only then that starting over is a choice
                             somebody has to be given. See PlayPrompts.CanResume. -->
                        <Button x:Name="StartAgainButton"
                                Classes="ghost"
                                Height="34"
                                IsVisible="False"
                                Content="Start again"
                                Click="StartAgain_Click"/>
                        <!-- On or off the Watchlist shelf on the library page.
                             Says which, so the button is also the answer to "did I
                             already add this". See Watchlist.ButtonLabel. -->
                        <Button x:Name="WatchlistButton"
                                Classes="ghost"
                                Height="34"
                                Content="+ Watchlist"
                                Click="Watchlist_Click"/>
                        <Button x:Name="LinkFileButton"
                                Classes="ghost"
                                Height="34"
                                Content="Link File…"
                                Click="LinkFile_Click"/>
                        <!-- The way out of a wrong TMDB match. Hidden for a server
                             film, which the server describes and the catalogue does
                             not own, so there is nothing here to correct. -->
                        <Button x:Name="CorrectMatchButton"
                                Classes="ghost"
                                Height="34"
                                Content="Wrong film?"
                                Click="CorrectMatch_Click"/>
                        <!-- Something wrong with this copy: the sound, the
                             resolution, the aspect ratio. The ticks live in a
                             flyout rather than on the page, because nearly every
                             film has nothing to report and six empty checkboxes
                             under every plot would be noise. The banner above the
                             genres says what has been reported. -->
                        <Button x:Name="ProblemButton"
                                Classes="ghost"
                                Height="34"
                                Content="Report problem…"
                                ToolTip.Tip="Mark this copy as having a problem: audio, low resolution, wrong aspect ratio…">
                            <Button.Flyout>
                                <Flyout
                                        Placement="TopEdgeAlignedLeft"
                                        Opening="ProblemFlyout_Opening">
                                    <StackPanel Width="300" Spacing="8">
                                        <TextBlock Classes="label"
                                                   Text="WHAT IS WRONG WITH THIS COPY"
                                                   LetterSpacing="1.6"/>
                                        <StackPanel x:Name="ProblemChoices" Spacing="2"/>
                                        <TextBox x:Name="ProblemNote"
                                                 Classes="field"
                                                 Watermark="Note (optional)"
                                                 MaxLength="500"
                                                 TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ProblemError"
                                                   Foreground="{StaticResource NoBrush}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="False"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Right">
                                            <Button x:Name="ClearProblemButton"
                                                    Classes="ghost"
                                                    Content="Clear"
                                                    Click="ClearProblem_Click"/>
                                            <Button x:Name="SaveProblemButton"
                                                    Classes="primary"
                                                    Content="Save"
                                                    Click="SaveProblem_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Keeps a copy on this disk so the film survives being away
                             from the server. Shown only for a server film that is not
                             already here. -->
                        <Button x:Name="DownloadButton"
                                Classes="ghost"
                                Height="34"
                                Content="Download"
                                IsVisible="False"
                                Click="Download_Click"/>
                        <ProgressBar x:Name="DownloadProgress"
                                     Width="120"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="1"
                                     VerticalAlignment="Center"
                                     IsVisible="False"/>
                        <!-- The other direction: puts a film from this disk onto the
                             server, which Jellyfin's own API cannot be asked to do.
                             Shown only for a local film with a file behind it, and
                             only when an SFTP account is configured. -->
                        <Button x:Name="UploadButton"
                                Classes="ghost"
                                Height="34"
                                Content="Upload to Jellyfin"
                                IsVisible="False"
                                Click="Upload_Click"/>
                        <ProgressBar x:Name="UploadProgress"
                                     Width="120"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="1"
                                     VerticalAlignment="Center"
                                     IsVisible="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock x:Name="FileNote"
                                   Classes="mono"
                                   FontSize="10.5"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   MaxWidth="660"/>
                        <!-- Attribution required by the TMDB API terms, with OMDb
                             credited as the rating source. A film from a server was
                             described by the server, so TMDB is not credited for
                             work it did not do. -->
                        <TextBlock x:Name="AttributionText"
                                   Classes="attribution"
                                   TextAlignment="Right"
                                   MaxWidth="660"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Poster and text. -->
            <Grid Margin="24,8,48,0" ColumnDefinitions="250,48,*">

                <!-- A grid rather than a stack, for the reason the series screen's
                     column is one: a StackPanel measures against infinite height,
                     so a film with seven nominations asked for a 375-pixel poster
                     and roughly 400 pixels of Academy underneath it whether the
                     window had the room or not, and drew the remainder over the
                     footer. The poster is pinned; the Academy takes what is left. -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <Border x:Name="PosterPlate"
                            Grid.Row="0"
                            Width="250"
                            Height="375"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource RadiusLarge}"
                            ClipToBounds="True"
                            BoxShadow="0 18 42 0 #800B0A09">
                        <Grid>
                            <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                            <Border CornerRadius="{StaticResource RadiusLarge}"
                                    BorderBrush="{StaticResource EdgeBrush}"
                                    BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <!--
                        The Academy, under the poster, in the column that was otherwise 375
                        pixels of picture over 400 of nothing.

                        Hidden outright for the great majority of films, which were never
                        nominated for anything. An empty "ACADEMY AWARDS" heading would be the
                        app telling every user that something failed to load.

                        Wins and nominations are told apart by a glyph and by weight, not by
                        colour — the same rule the connection indicators follow, and for the
                        same reason.
                    -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  Padding="0,0,12,0"
                                  Margin="0,0,0,16">
                        <StackPanel>
                        <!--
                            The owner's own history with the film: a rating out of ten, a few
                            words, and each time they watched it — the day, who with, a note.

                            Ten stars because UrActor uses ten, so a later sync has nothing to
                            convert. Kept in the catalogue on this computer and sent nowhere; see
                            FilmJournalStore. Hidden when the film cannot be named at all.
                        -->
                        <StackPanel x:Name="JournalPanel"
                                    Margin="0,22,0,0"
                                    IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                                <TextBlock Classes="label"
                                           Text="YOUR RATING"
                                           LetterSpacing="1.6"/>
                                <TextBlock x:Name="RatingValue"
                                           Grid.Column="1"
                                           Classes="mono"
                                           FontSize="11.5"
                                           Foreground="{StaticResource BrassBrush}"
                                           VerticalAlignment="Bottom"/>
                            </Grid>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,6"/>
                            <StackPanel x:Name="StarsRow"
                                        Orientation="Horizontal"/>
                            <TextBox x:Name="ReviewBox"
                                     Classes="field"
                                     Margin="0,6,0,0"
                                     MaxHeight="96"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Watermark="What did you think?"
                                     LostFocus="ReviewBox_LostFocus"/>

                            <TextBlock Classes="label"
                                       Text="VIEWINGS"
                                       LetterSpacing="1.6"
                                       Margin="0,16,0,5"/>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="NoViewingsText"
                                       Classes="dim"
                                       FontSize="11.5"
                                       Text="Not logged yet."
                                       Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ViewingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:FilmViewing">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Classes="mono"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource BoneBrush}"
                                                           Text="{Binding WatchedOnText}"/>
                                                <TextBlock Classes="castRole"
                                                           Text="{Binding CompanionsText}"
                                                           IsVisible="{Binding HasCompanions}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Classes="castRole"
                                                           Text="{Binding Note}"
                                                           IsVisible="{Binding HasNote}"
                                                           FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="ghost"
                                                    Padding="6,0"
                                                    Height="22"
                                                    VerticalAlignment="Top"
                                                    Content="✕"
                                                    Tag="{Binding Id}"
                                                    ToolTip.Tip="Forget this viewing"
                                                    Click="RemoveViewing_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="LogViewingButton"
                                    Classes="ghost"
                                    Height="30"
                                    Margin="0,2,0,0"
                                    Content="+ I watched this"
                                    Click="LogViewing_Click"/>

                            <StackPanel x:Name="LogViewingForm"
                                        Spacing="6"
                                        Margin="0,4,0,0"
                                        IsVisible="False">
                                <CalendarDatePicker x:Name="WatchedOnPicker"
                                                    HorizontalAlignment="Stretch"
                                                    SelectedDateFormat="Long"/>
                                <TextBox x:Name="CompanionsBox"
                                         Classes="field"
                                         Watermark="Who with? Ana, Luis"
                                         TextChanged="CompanionsBox_TextChanged"/>
                                <!-- Everybody logged before, most often first, one click
                                     each. A chip adds the name to the line, or takes it
                                     out again; the line stays the thing that is saved. -->
                                <ItemsControl x:Name="CompanionChips">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:CompanionChip">
                                            <ToggleButton Classes="companion"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding IsIncluded, Mode=OneWay}"
                                                          Tag="{Binding Name}"
                                                          Click="CompanionChip_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox x:Name="ViewingNoteBox"
                                         Classes="field"
                                         Watermark="Note (optional)"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveViewingButton"
                                            Classes="primary"
                                            Content="Log it"
                                            Click="SaveViewing_Click"/>
                                    <Button Classes="ghost"
                                            Height="34"
                                            Content="Cancel"
                                            Click="CancelViewing_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="JournalStatus"
                                       Classes="dim"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       IsVisible="False"
                                       Margin="0,6,0,0"/>
                            <TextBlock Classes="attribution"
                                       Margin="0,8,0,0"
                                       Text="Kept on this computer only."/>
                        </StackPanel>

                        <StackPanel x:Name="AwardsPanel"
                                    Margin="0,22,0,0"
                                    IsVisible="False">
                            <TextBlock x:Name="AwardsHeading"
                                       Classes="label"
                                       Text="ACADEMY AWARDS"
                                       LetterSpacing="1.6"
                                       Margin="0,0,0,5"/>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="AwardsSummary"
                                       Classes="mono"
                                       FontSize="11.5"
                                       Foreground="{StaticResource ProseBrush}"
                                       Margin="0,0,0,9"/>
                            <ItemsControl x:Name="AwardsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:AwardRow">
                                        <Grid ColumnDefinitions="15,*" Margin="0,0,0,7"
                                              ToolTip.Tip="{Binding Tip}">
                                            <TextBlock Grid.Column="0"
                                                       Classes="awardMark"
                                                       Classes.won="{Binding Won}"
                                                       Text="{Binding Mark}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="awardCategory"
                                                           Classes.won="{Binding Won}"
                                                           Text="{Binding Category}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Classes="awardDetail"
                                                           Text="{Binding Detail}"
                                                           IsVisible="{Binding HasDetail}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AwardsMore"
                                       Classes="dim"
                                       FontSize="11"
                                       IsVisible="False"
                                       Margin="15,1,0,0"/>
                            <TextBlock x:Name="AwardsAttribution"
                                       Classes="attribution"
                                       Margin="0,10,0,0"
                                       Text="Academy Awards data from the UrActor API."/>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- One stack, top to bottom, every row at its own height, and
                     the whole column scrolls when the window is shorter than it.
                     Nothing here stretches to fill the window: a row that took
                     "the space that is left" opened a band of empty backdrop on
                     a tall window and pinned the credits to the foot of it. The
                     plot alone is capped, by DetailsLayout, so a long synopsis
                     does not push everything else below the fold. Horizontal
                     scrolling is disabled so the shelves are measured against
                     the real width and fill it. The column's right margin keeps
                     the scroll bar off the shelves' right-hand arrows. -->
                <ScrollViewer x:Name="DetailsScroller"
                              Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                <Grid x:Name="DetailsColumn"
                      VerticalAlignment="Top"
                      Margin="0,0,14,0"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <TextBlock Grid.Row="0"
                               x:Name="TitleText"
                               Classes="display"
                               FontSize="46"
                               LineHeight="48"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,12"/>

                    <!-- Each number under its own source's name, then what is known about the
                         copy itself as badges beside them. One row, because they answer one
                         question between them — is this the film I want, in the form I want it.

                         A WrapPanel rather than a StackPanel: a server film with eight audio
                         languages produces a long row, and the alternative to wrapping is
                         pushing the ratings off the side of the window. -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                        <ItemsControl x:Name="FactsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:DetailFact">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Classes="label"
                                                       Text="{Binding Label}"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Classes="factValue"
                                                       Classes.imdb="{Binding IsImdb}"
                                                       Classes.server="{Binding IsServer}"
                                                       Text="{Binding Value}"/>
                                        </StackPanel>
                                        <Rectangle Width="1"
                                                   Fill="{StaticResource EdgeBrush}"
                                                   Margin="0,0,16,0"
                                                   IsVisible="{Binding ShowSeparator}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom-aligned so the chips sit on the same line as the fact values
                             above their labels, not floating halfway up the row. -->
                        <ItemsControl x:Name="FlagsList" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:MediaFlag">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="label"
                                                   Text="{Binding GroupLabel}"
                                                   IsVisible="{Binding HasGroupLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,7,5"/>
                                        <Border Classes="flag"
                                                Classes.lang="{Binding IsLanguage}"
                                                Classes.sub="{Binding IsSubtitle}"
                                                ToolTip.Tip="{Binding Tip}">
                                            <TextBlock Classes="flagText" Text="{Binding Text}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <StackPanel Grid.Row="2">
                        <!-- What the owner reported wrong with this copy. Hidden
                             for nearly every film. Outlined in the same
                             red-orange as the card's badge, with the word on it,
                             so the two are recognisably one fact. -->
                        <Border x:Name="ProblemBanner"
                                HorizontalAlignment="Left"
                                BorderBrush="{StaticResource NoBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="8,4,4,4"
                                Margin="0,0,0,12"
                                IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="PROBLEM"
                                           Foreground="{StaticResource NoBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProblemSummary"
                                           Foreground="{StaticResource ProseBrush}"
                                           FontSize="12.5"
                                           MaxWidth="560"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ProblemBannerClear"
                                        Classes="ghost"
                                        Content="Clear"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="This copy is fine now: remove the problem."
                                        Click="ClearProblem_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- A catalogued film with no file at all: a leftover the scan
                             keeps only because a person put something into it. Says
                             which, and offers the way out. See OrphanFilms. -->
                        <Border x:Name="OrphanBanner"
                                HorizontalAlignment="Left"
                                BorderBrush="{StaticResource EdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="8,4,4,4"
                                Margin="0,0,0,12"
                                IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="NO FILE"
                                           Foreground="{DynamicResource DimBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="OrphanSummary"
                                           Foreground="{StaticResource ProseBrush}"
                                           FontSize="12.5"
                                           MaxWidth="560"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="RemoveFromLibraryButton"
                                        Classes="ghost"
                                        Content="Remove from library"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Take this film out of the library. It has no file to play."
                                        Click="RemoveFromLibrary_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="GenresText"
                                   Classes="mono"
                                   FontSize="11"
                                   LetterSpacing="1.1"
                                   Foreground="{StaticResource ProseBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                    </StackPanel>

                    <Border x:Name="PlotPane"
                            Grid.Row="3"
                            BorderBrush="{StaticResource EdgeBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,12">
                        <!-- Transparent so the wheel has something to land on:
                             a long plot could not otherwise be scrolled except
                             with the cursor exactly over its text. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      Padding="0,0,16,0">
                            <TextBlock x:Name="OverviewText"
                                       Classes="body"
                                       MaxWidth="680"
                                       HorizontalAlignment="Left"/>
                        </ScrollViewer>
                    </Border>

                    <!--
                        Frames from the film, directly under its plot. TMDB's
                        text-free backdrops, which for nearly every film are
                        stills from it; see FilmStills for why not frames read
                        out of the file.

                        Small on purpose: this column already holds a plot, a
                        shelf and the credits, and the strip is an invitation to
                        look rather than the look itself. Clicking one opens it
                        across the whole window.

                        Hidden when there are none, which is every film without
                        a TMDB key and an identification. A heading over an
                        empty row would report a failure nobody had.
                    -->
                    <StackPanel x:Name="StillsPane"
                                Grid.Row="4"
                                Margin="0,16,0,0"
                                IsVisible="False">
                        <TextBlock Classes="label"
                                   Text="STILLS"
                                   LetterSpacing="1.6"
                                   Margin="0,0,0,5"/>
                        <Rectangle Height="1"
                                   Fill="{StaticResource EdgeBrush}"
                                   Margin="0,0,0,10"/>
                        <ctrls:ScrollableShelf Padding="0,0,0,4">
                            <ItemsControl x:Name="StillsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:FilmStill">
                                        <Border Classes="still"
                                                Width="160"
                                                Height="90"
                                                Margin="0,0,10,0"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="#1AFFFFFF"
                                                Cursor="Hand"
                                                PointerPressed="StillCard_Click"
                                                ToolTip.Tip="Click to enlarge">
                                            <ctrls:AsyncImage SourcePath="{Binding Thumbnail}"
                                                              Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ctrls:ScrollableShelf>
                    </StackPanel>

                    <!--
                        What to put on next, and the answer is always something
                        already owned. This row is where a series lists its
                        episodes; a film has no episodes, and what it had
                        instead was several hundred pixels of backdrop nobody
                        was reading.

                        Every poster here is a film in this library, so every
                        one of them plays. A shelf of things TMDB recommends
                        that the user does not own would be an advertisement
                        rather than a library, which is why the recommendation
                        supplies only the ordering — see RelatedFilms.

                        Hidden entirely when it is empty, and the column closes
                        up over it. A heading over an empty row is the app
                        reporting a failure it did not have.
                    -->
                    <StackPanel x:Name="RelatedPane"
                                Grid.Row="5"
                                Margin="0,16,0,0"
                                IsVisible="False">
                        <TextBlock x:Name="RelatedHeading"
                                   Classes="label"
                                   LetterSpacing="1.6"
                                   Margin="0,0,0,5"/>
                        <Rectangle Height="1"
                                   Fill="{StaticResource EdgeBrush}"
                                   Margin="0,0,0,10"/>
                        <ctrls:ScrollableShelf Padding="0,0,0,4">
                            <ItemsControl x:Name="RelatedList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:UiMovie">
                                        <!-- The library's own card, at the library's own size and
                                             with no caption under it. Deliberately identical: a
                                             film is recognised by its poster here exactly as it is
                                             two clicks away, and the title it would carry
                                             underneath is already printed on the plate of any film
                                             whose artwork has not arrived yet. -->
                                        <StackPanel Classes="card"
                                                    Width="152"
                                                    Margin="0,0,14,0"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    PointerPressed="RelatedCard_Click"
                                                    ToolTip.Tip="{Binding Title}">
                                            <Grid>
                                                <ctrls:PosterCard SourcePath="{Binding DisplayPosterPath}"
                                                                  Title="{Binding Title}"
                                                                  Year="{Binding Year}"/>
                                                <Border Classes="ring"
                                                        CornerRadius="{StaticResource PosterRadius}"
                                                        BorderThickness="1"
                                                        BorderBrush="Transparent"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ctrls:ScrollableShelf>
                    </StackPanel>

                    <Grid Grid.Row="6"
                          ColumnDefinitions="*,48,260"
                          Margin="0,16,0,24">

                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="label"
                                       Text="CAST"
                                       LetterSpacing="1.6"
                                       Margin="0,0,0,5"/>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,8"/>
                            <!-- A two-column list of name over character, not a
                                 row of chips. A chip reading "Keir Dullea as
                                 Dave Bowman" is a chip nobody can scan, and ten
                                 of them in a horizontal scroller is a list you
                                 have to drag to read. -->
                            <ItemsControl x:Name="CastList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" MaxHeight="120"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:CreditEntry">
                                        <StackPanel Width="230" Margin="0,0,24,4">
                                            <TextBlock Classes="castName"
                                                       Text="{Binding Primary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Classes="castRole"
                                                       Text="{Binding Secondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding HasSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoCastText"
                                       Classes="dim"
                                       IsVisible="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label"
                                       Text="CREW"
                                       LetterSpacing="1.6"
                                       Margin="0,0,0,5"/>
                            <Rectangle Height="1"
                                       Fill="{StaticResource EdgeBrush}"
                                       Margin="0,0,0,8"/>
                            <!-- The same 120 pixels the cast beside it is held to,
                                 so the two halves of the credits end on one line
                                 rather than one of them running on past the other
                                 and out through the footer. Six crew wrapping onto
                                 two lines each is the case that overruns it, and it
                                 scrolls rather than being cut off. -->
                            <ScrollViewer MaxHeight="120"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"
                                          Padding="0,0,12,0">
                                <ItemsControl x:Name="CrewList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:CreditEntry">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Classes="label"
                                                           Text="{Binding Secondary}"
                                                           Width="62"
                                                           IsVisible="{Binding HasSecondary}"/>
                                                <TextBlock Classes="castName"
                                                           Text="{Binding Primary}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoCrewText"
                                       Classes="dim"
                                       IsVisible="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- One still across the whole window. Above everything, opaque enough
             that the page behind it is a suggestion, and closed by a click
             anywhere or by Escape; the arrow keys step through the strip. -->
        <Border x:Name="StillViewer"
                Background="#F20B0A09"
                IsVisible="False"
                Focusable="True"
                FocusAdorner="{x:Null}"
                Cursor="Hand"
                PointerPressed="StillViewer_Click">
            <Grid RowDefinitions="*,Auto" Margin="48,32">
                <Image x:Name="StillViewerImage"
                       Stretch="Uniform"/>
                <TextBlock x:Name="StillViewerCaption"
                           Grid.Row="1"
                           Classes="label"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
