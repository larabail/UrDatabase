<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="clr-namespace:UrDatabase.Controls"
        xmlns:conv="clr-namespace:UrDatabase.Converters"
        xmlns:models="clr-namespace:UrDatabase.Models"
        xmlns:views="clr-namespace:UrDatabase.Views"
        x:Class="UrDatabase.Views.MainWindow"
        Title="UrDatabase"
        Width="1400"
        Height="900"
        MinWidth="1000"
        MinHeight="700"
        Background="{StaticResource RoomBrush}"
        WindowStartupLocation="CenterScreen">

    <!--
        The Screening Room.

        The room is dark, the chrome is dimmed almost to nothing, and the only
        lit thing is the artwork. Every control up here is either a hairline or
        a piece of text, because three buttons drawn with any conviction will
        beat forty posters for attention, and the posters are the point.

        Brushes come from Styles/Tokens.axaml rather than being declared at the
        top of this file, which is what this window used to do.
    -->

    <Window.Resources>
        <conv:EqualsConverter x:Key="EqualsConverter"/>

        <!-- One card definition, reused by the shelves, the single-genre grid
             and the search results. -->
        <DataTemplate x:Key="MovieCardTemplate" DataType="models:UiMovie">
            <StackPanel Classes="card"
                        Width="152"
                        Margin="0,0,14,20"
                        Background="Transparent"
                        Cursor="Hand"
                        PointerPressed="MovieCard_Click"
                        ToolTip.Tip="{Binding Title}">
                <Grid>
                    <ctrls:PosterCard SourcePath="{Binding PosterPath}"
                                      Title="{Binding Title}"
                                      Year="{Binding Year}"/>

                    <!-- The hover edge. A Border of its own rather than the
                         card's, so pointing at a film lights it without
                         disturbing the plate underneath. -->
                    <Border Classes="ring"
                            CornerRadius="{StaticResource PosterRadius}"
                            BorderThickness="1"
                            BorderBrush="Transparent"/>

                    <!-- Says which films are not on this machine. Without it a
                         server film looks identical to a local one right up
                         until the network is gone. Filled rather than
                         outlined, because the question it answers — will this
                         play on a train — has to be answerable from six feet
                         away without reading. -->
                    <Border Background="{StaticResource AwayBrush}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="6,2"
                            Margin="0,8,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsVisible="{Binding IsRemote}">
                        <TextBlock Text="{Binding SourceLabel}"
                                   Foreground="{StaticResource RoomBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1"/>
                    </Border>
                </Grid>

                <!-- Exactly two lines, always, as a fixed height rather than a
                     trim. "The Assassination of Jesse James by the Coward
                     Robert Ford" is 57 characters and would otherwise grow its
                     own card, push its meta line 30px below its neighbours'
                     and shunt the next shelf off the screen. The full title is
                     in the tooltip and on the details screen; a grid's job is
                     recognition, and that film is recognisable from its first
                     four words. -->
                <TextBlock Classes="ct"
                           Text="{Binding Title}"
                           Foreground="{StaticResource ProseBrush}"
                           FontSize="12.5"
                           LineHeight="16.5"
                           Height="33"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,9,0,2"/>

                <!-- The year alone. The library query reads title, year, genres
                     and poster and nothing else, so a runtime here would be a
                     number the app does not have. -->
                <TextBlock Classes="mono"
                           FontSize="10.5"
                           Text="{Binding Year}"
                           IsVisible="{Binding Year, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- The lift. The only movement in the library, and it is 3px: enough
             to say "this one", not enough to make a shelf ripple. -->
        <Style Selector="StackPanel.card">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.card:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)"/>
        </Style>
        <Style Selector="StackPanel.card:pointerover Border.ring">
            <Setter Property="BorderBrush" Value="{DynamicResource BrassBrush}"/>
        </Style>
        <Style Selector="StackPanel.card:pointerover TextBlock.ct">
            <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
        </Style>
    </Window.Styles>

    <!-- The details screen is a sibling of the library rather than a window of
         its own, so a backdrop gets all 1400x900 instead of 1000x640 inside it. -->
    <Grid>
        <DockPanel x:Name="LibraryRoot">

            <StackPanel DockPanel.Dock="Top">

                <!-- The top bar: the wordmark, search, and the three things you
                     can do. -->
                <Grid Height="56"
                      Margin="24,0"
                      ColumnDefinitions="Auto,16,*,16,Auto">

                    <TextBlock Grid.Column="0"
                               Classes="display"
                               FontSize="21"
                               VerticalAlignment="Center">
                        <Run Text="Ur"/><Run Text="Database"
                                             FontStyle="Italic"
                                             Foreground="{StaticResource BrassBrush}"/>
                    </TextBlock>

                    <!-- A field, not a pill. A desktop text input that does not
                         look like a text input is a desktop text input nobody
                         types in. -->
                    <Panel Grid.Column="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="460">
                        <TextBox x:Name="SearchBox"
                                 Classes="field"
                                 TextChanged="SearchBox_TextChanged"/>
                        <!-- The shortcut is printed because the app supports it
                             and nothing else would ever say so. -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0"
                                Padding="5,1"
                                IsHitTestVisible="False"
                                BorderBrush="{StaticResource EdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <TextBlock x:Name="SearchKeycapText"
                                       Classes="mono"
                                       FontSize="10"/>
                        </Border>
                    </Panel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="ghost"
                                x:Name="ScanButton"
                                Content="Scan Folders"
                                Click="ScanButton_Click"/>
                        <!-- Hidden unless a server is configured, so an install
                             with no Jellyfin looks exactly as it did before. -->
                        <Button Classes="ghost away"
                                x:Name="JellyfinButton"
                                Content="Sync Jellyfin"
                                IsVisible="False"
                                Click="JellyfinSyncButton_Click"/>
                        <Button Classes="ghost"
                                Content="Settings"
                                Click="Settings_Click"/>
                    </StackPanel>
                </Grid>

                <!-- The genre row: typed labels with counts, not pills. The
                     counts are the point — a row without them tells you the
                     library has a Western bucket but not whether it holds two
                     films or two hundred. -->
                <!-- Two different questions, on one line but not in one row:
                     where a film is, and what it is. They are divided by a
                     hairline because folding them together is what buried the
                     local films in the first place — a scanned film has no
                     genre, so all of them sat in a bucket that sorts last,
                     behind every genre the server library brought with it. -->
                <Border BorderBrush="{StaticResource EdgeBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,*">

                        <!-- Hidden entirely unless films come from more than one
                             place, so an install with only local films — or only
                             a server — grows no furniture it has no use for. -->
                        <ItemsControl x:Name="SourceChipsList"
                                      Grid.Column="0"
                                      ItemsSource="{Binding SourceChips}"
                                      IsVisible="False"
                                      Margin="24,0,0,0"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:SourceChip">
                                    <ToggleButton Classes="genre source"
                                                  Classes.server="{Binding IsServer}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="0,0,20,0"
                                                  VerticalAlignment="Center"
                                                  Click="SourceChip_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="genreLabel"
                                                       Text="{Binding Name}"
                                                       FontSize="12.5"/>
                                            <TextBlock Classes="mono"
                                                       Text="{Binding Count}"
                                                       FontSize="10"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle x:Name="SourceDivider"
                                   Grid.Column="1"
                                   Width="1"
                                   Height="16"
                                   IsVisible="False"
                                   Margin="4,0,20,0"
                                   Fill="{StaticResource EdgeBrush}"
                                   VerticalAlignment="Center"/>

                        <ScrollViewer Grid.Column="2" Classes="shelf" Height="40" Padding="24,0">
                            <ItemsControl x:Name="GenreChipsList" ItemsSource="{Binding GenreChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:GenreChip">
                                        <ToggleButton Classes="genre"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="0,0,24,0"
                                                      VerticalAlignment="Center"
                                                      Click="GenreChip_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Classes="genreLabel"
                                                           Text="{Binding Name}"
                                                           FontSize="12.5"/>
                                                <TextBlock Classes="mono"
                                                           Text="{Binding Count}"
                                                           FontSize="10"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- The foot: what the app is doing, and the attribution the TMDB
                 and OMDb terms require. Docked, so it is permanently on screen
                 — moving it into an About box would be a licence breach. -->
            <Border DockPanel.Dock="Bottom"
                    Height="46"
                    Background="{StaticResource WallBrush}"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,0">
                <Grid ColumnDefinitions="Auto,16,*" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <!-- A 2px brass bar is the only moving thing in the
                             window, which is the honest place for the accent:
                             something is actually happening. Hidden when
                             nothing is running. -->
                        <Border x:Name="LiveTrack"
                                Width="44"
                                Height="2"
                                CornerRadius="1"
                                IsVisible="False"
                                Background="{StaticResource EdgeBrush}"
                                VerticalAlignment="Center">
                            <Border Width="15"
                                    Height="2"
                                    CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource BrassBrush}"/>
                        </Border>
                        <TextBlock x:Name="StatusText"
                                   Classes="mono"
                                   FontSize="11"
                                   Foreground="{StaticResource ProseBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Classes="attribution"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               MaxWidth="640"
                               VerticalAlignment="Center"
                               Text="This product uses the TMDB API but is not endorsed or certified by TMDB. IMDb ratings are retrieved from the OMDb API; neither IMDb nor OMDb endorses this application."/>
                </Grid>
            </Border>

            <!-- The hall. -->
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="24,24,0,24">
                    <StackPanel>

                        <!-- SEARCH RESULTS (flat) -->
                        <StackPanel x:Name="SearchPanel" IsVisible="False">
                            <Grid ColumnDefinitions="Auto,12,*,12,Auto" Margin="0,0,24,12">
                                <TextBlock Grid.Column="0"
                                           Classes="display"
                                           FontSize="20"
                                           Text="Search"
                                           VerticalAlignment="Center"/>
                                <Rectangle Grid.Column="2"
                                           Height="1"
                                           Fill="{StaticResource EdgeBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4"
                                           x:Name="SearchCountText"
                                           Classes="label"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding FlatResults}"
                                          ItemTemplate="{StaticResource MovieCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!-- A search that found nothing has to say so.
                                 Silence reads as a broken search box. -->
                            <TextBlock x:Name="NoResultsText"
                                       Classes="body"
                                       IsVisible="False"
                                       Margin="0,4,24,0"/>
                        </StackPanel>

                        <!-- ALL GENRES (one shelf per genre) -->
                        <StackPanel x:Name="GroupPanel" IsVisible="True">
                            <ItemsControl ItemsSource="{Binding VisibleGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:GenreGroup">
                                        <StackPanel Margin="0,0,0,12">
                                            <!-- The rule runs from the heading
                                                 out to the window edge, which
                                                 is a Rectangle in the star
                                                 column and is exactly as cheap
                                                 as it looks. -->
                                            <Grid ColumnDefinitions="Auto,12,*,12,Auto" Margin="0,0,24,12">
                                                <TextBlock Grid.Column="0"
                                                           Classes="display"
                                                           FontSize="20"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"/>
                                                <Rectangle Grid.Column="2"
                                                           Height="1"
                                                           Fill="{StaticResource EdgeBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4"
                                                           Classes="label"
                                                           Text="{Binding CountLabel}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <ScrollViewer Classes="shelf">
                                                <ItemsControl ItemsSource="{Binding Items}"
                                                              ItemTemplate="{StaticResource MovieCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- SINGLE GENRE (vertical flow) -->
                        <StackPanel x:Name="SingleGenrePanel" IsVisible="False">
                            <Grid ColumnDefinitions="Auto,12,*,12,Auto" Margin="0,0,24,12">
                                <TextBlock Grid.Column="0"
                                           Classes="display"
                                           FontSize="20"
                                           Text="{Binding SelectedGenre}"
                                           VerticalAlignment="Center"/>
                                <Rectangle Grid.Column="2"
                                           Height="1"
                                           Fill="{StaticResource EdgeBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4"
                                           x:Name="SingleGenreCountText"
                                           Classes="label"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SingleGenreItems}"
                                          ItemTemplate="{StaticResource MovieCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- NOTHING SCANNED YET. A fresh install used to open
                             on a blank grey page, which is indistinguishable
                             from a scan that failed. -->
                        <StackPanel x:Name="EmptyPanel"
                                    IsVisible="False"
                                    Margin="0,120,24,0"
                                    MaxWidth="560"
                                    HorizontalAlignment="Center">
                            <TextBlock Classes="display"
                                       FontSize="34"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="Nothing in the library yet"/>
                            <TextBlock Classes="body"
                                       TextAlignment="Center"
                                       Margin="0,12,0,24"
                                       Text="Point UrDatabase at the folders your films are in and scan them, or connect a Jellyfin server. Nothing is copied or moved — only what is found is recorded."/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Center">
                                <Button Classes="primary"
                                        Content="Choose folders"
                                        Click="Settings_Click"/>
                                <Button Classes="ghost"
                                        Height="34"
                                        Content="Scan now"
                                        Click="ScanButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- The one atmospheric move in the design: a shallow vignette,
                     so the shelves read as lit from the middle of the room. Not
                     hit testable, or it would eat every click meant for a
                     poster. -->
                <Rectangle Fill="{StaticResource VignetteBrush}"
                           IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>

        <!-- Details, in place, over the whole window. -->
        <views:MovieDetailsView x:Name="DetailsView" IsVisible="False"/>
    </Grid>
</Window>
