<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UrDatabase.Views.SetupWindow"
        Title="UrDatabase — Setup"
        Width="820"
        Height="820"
        MinWidth="640"
        MinHeight="600"
        Background="{StaticResource RoomBrush}"
        WindowStartupLocation="CenterScreen">

    <!--
        The same room as the library, at the one moment the user has no films to
        look at. It is also the first screen of a fresh install, so nothing here
        is allowed to look like a form that must be completed: both API keys are
        optional, and the app works with neither.
    -->

    <Window.Styles>
        <Style Selector="Border.panel">
            <!-- Same reason: an unfilled panel does not take pointer events, so
                 the wheel did nothing over the largest areas of the screen. -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style Selector="TextBlock.panelHeading">
            <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="CheckBox.section">
            <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!--
            The save bar is docked rather than being the last thing in the
            scroller. A settings pane whose primary button is only reachable by
            scrolling past the optional API keys is a pane where people believe
            their changes were not saved — and this is also the first screen
            anyone sees.
        -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource WallBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                <!-- The reason the answer is not accepted yet sits directly
                     above the button that would accept it. -->
                <TextBlock x:Name="ProblemText"
                           Foreground="{StaticResource NoBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,16,Auto">
                    <TextBlock x:Name="SavePathText"
                               Grid.Column="0"
                               Classes="mono"
                               FontSize="10.5"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="SkipButton"
                                Classes="ghost"
                                Height="34"
                                Content="Skip"
                                ToolTip.Tip="Goes straight to the library and does not ask again. The Settings button reopens this."
                                Click="Skip_Click"/>
                        <Button x:Name="FinishButton"
                                Classes="primary"
                                Content="Finish"
                                Click="Finish_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- The breathing room is a margin on the content, not padding on the
             scroller. A ScrollViewer's bottom padding is not part of what it
             will scroll to, so the last panel stayed jammed under the docked
             save bar with no way to reach it — on this window that meant the
             two API key fields could not be seen, let alone typed into. -->
        <!-- Transparent, not unset. A control with a null Background is not
             hit-testable in Avalonia, so the wheel found nothing to scroll
             across most of this window and the pane appeared to stop short of
             its own last field. Transparent paints nothing and still takes the
             pointer. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <StackPanel MaxWidth="720"
                        HorizontalAlignment="Center"
                        Margin="0,32">

                <TextBlock x:Name="HeadingText"
                           Classes="display"
                           FontSize="32"
                           TextWrapping="Wrap"
                           Text="Welcome to UrDatabase"/>
                <TextBlock x:Name="SubheadingText"
                           Classes="body"
                           Margin="0,8,0,28"
                           Text="Tell it where your films are. You can use folders on this computer, a Jellyfin server, or both."/>

                <!-- Hidden unless the settings file holds a key the app has no
                     such thing as. This is the screen somebody opens to correct
                     that, so it is the screen that has to say so. -->
                <Border x:Name="ConfigWarningPanel"
                        Classes="panel"
                        IsVisible="False"
                        Margin="0,0,0,28">
                    <TextBlock x:Name="ConfigWarningText"
                               Foreground="{StaticResource NoBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Local folders -->
                <Border Classes="panel">
                    <StackPanel>
                        <CheckBox x:Name="LocalCheck"
                                  Classes="section"
                                  Content="Films on this computer"
                                  IsCheckedChanged="Check_Changed"/>
                        <TextBlock Classes="dim"
                                   Margin="0,6,0,0"
                                   Text="Folders are searched all the way down. Nothing is copied or moved — UrDatabase only records what it finds."/>

                        <StackPanel x:Name="LocalPanel" Margin="0,16,0,0">
                            <ListBox x:Name="FolderList"
                                     Height="120"
                                     Background="{StaticResource WallBrush}"
                                     Foreground="{StaticResource ProseBrush}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11.5"
                                     BorderBrush="{StaticResource EdgeBrush}"
                                     BorderThickness="1"
                                     CornerRadius="{StaticResource RadiusMedium}"
                                     SelectionChanged="FolderList_SelectionChanged"/>
                            <TextBlock x:Name="FolderNote"
                                       Classes="dim"
                                       Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                                <Button x:Name="AddFolderButton"
                                        Classes="ghost"
                                        Content="Add folder…"
                                        Click="AddFolder_Click"/>
                                <Button x:Name="RemoveFolderButton"
                                        Classes="ghost"
                                        Content="Remove"
                                        IsEnabled="False"
                                        Click="RemoveFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Jellyfin -->
                <Border Classes="panel">
                    <StackPanel>
                        <CheckBox x:Name="JellyfinCheck"
                                  Classes="section"
                                  Content="A Jellyfin server"
                                  IsCheckedChanged="Check_Changed"/>
                        <TextBlock Classes="dim"
                                   Margin="0,6,0,0"
                                   Text="Its films are streamed, and only the list and the artwork are cached here. Any one of them can be downloaded to watch offline."/>

                        <StackPanel x:Name="JellyfinPanel" Margin="0,16,0,0" Spacing="14">
                            <StackPanel>
                                <TextBlock Classes="label" Text="SERVER ADDRESS" Margin="0,0,0,5"/>
                                <TextBox x:Name="ServerUrlBox"
                                         Classes="field mono"
                                         Watermark="media-box:8096"
                                         TextChanged="Text_Changed"/>
                                <TextBlock Classes="dim"
                                           Margin="0,6,0,0"
                                           Text="A bare host gets http:// added, since a server on a home network usually has no certificate."/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="label" Text="USERNAME" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UsernameBox"
                                             Classes="field"
                                             TextChanged="Text_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="label" Text="PASSWORD" Margin="0,0,0,5"/>
                                    <TextBox x:Name="PasswordBox"
                                             Classes="field"
                                             PasswordChar="•"
                                             TextChanged="Text_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="label" Text="API KEY (INSTEAD OF A USERNAME)" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ApiKeyBox"
                                             Classes="field mono"
                                             PasswordChar="•"
                                             TextChanged="Text_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="label" Text="LIBRARY (BLANK PICKS THE FIRST)" Margin="0,0,0,5"/>
                                    <TextBox x:Name="LibraryBox"
                                             Classes="field"
                                             TextChanged="Text_Changed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="dim"
                                       Text="Every Jellyfin API key is administrative, so signing in as your own account is the safer of the two."/>

                            <TextBlock x:Name="PlayerNoteText" Classes="dim"/>

                            <!-- Three states in one row, and never a colour on
                                 its own: each carries a glyph too, because a red
                                 dot and a green dot are the same dot to about
                                 one man in twelve. -->
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Button x:Name="TestButton"
                                        Classes="ghost"
                                        Content="Test connection"
                                        Click="Test_Click"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="7"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="TestResultGlyph"
                                               Classes="mono"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsVisible="False"/>
                                    <TextBlock x:Name="TestResultText"
                                               Classes="mono"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               MaxWidth="420"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Metadata keys. Optional means optional: this panel is drawn
                     at the same weight as the others, its heading says so, and
                     no field in it is ever marked required or outlined in a
                     warning colour. -->
                <Border Classes="panel">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="panelHeading"
                                       Text="Posters and ratings"
                                       VerticalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource EdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="label" Text="OPTIONAL"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="KeyNoteText"
                                   Classes="dim"
                                   Margin="0,6,0,0"/>

                        <Grid ColumnDefinitions="*,16,*" Margin="0,16,0,0">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="label" Text="TMDB API KEY" Margin="0,0,0,5"/>
                                <TextBox x:Name="TmdbKeyBox"
                                         Classes="field mono"
                                         PasswordChar="•"
                                         TextChanged="Text_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="OMDB API KEY" Margin="0,0,0,5"/>
                                <TextBox x:Name="OmdbKeyBox"
                                         Classes="field mono"
                                         PasswordChar="•"
                                         TextChanged="Text_Changed"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Classes="dim"
                                   Margin="0,12,0,0"
                                   Text="Keys are written to this machine's settings file only. A Jellyfin library needs neither: the server describes its own films."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
