<Window x:Class="UrDatabase.Views.MovieDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Details"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0C">
    <Grid>
        <!-- Backdrop -->
        <Grid>
            <Image Source="{Binding BackdropUrl}"
                   Stretch="UniformToFill"
                   Opacity="0.35"/>
            <!-- gradient to darken bottom -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Color="#00000000"
                                      Offset="0"/>
                        <GradientStop Color="#CC000000"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Foreground content -->
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Poster -->
            <Border Grid.Column="0"
                    CornerRadius="18"
                    Background="#1E1E1E"
                    Padding="4"
                    Width="250"
                    Height="375">
                <Image Stretch="UniformToFill"
                       Source="{Binding PosterPath}"
                       ClipToBounds="True"/>
            </Border>

            <!-- Text + actions -->
            <StackPanel Grid.Column="2"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding Title}"
                        Foreground="White"
                        FontSize="28"
                        FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,12">
                    <Border Background="#2A2A2A"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="0,0,8,0">
                        <TextBlock Foreground="#EAEAEA"
                                Text="{Binding Year}"/>
                    </Border>
                    <Border Background="#2A2A2A"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="0,0,8,0">
                        <TextBlock Foreground="#EAEAEA"
                                Text="{Binding Runtime, StringFormat={}{0} min}"/>
                    </Border>
                    <Border Background="#0A84FF"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="0,0,8,0">
                        <TextBlock Foreground="White"
                                Text="{Binding ImdbRating, StringFormat=★ {0:0.0}}"/>
                    </Border>
                </StackPanel>

                <TextBlock Foreground="#CFCFCF"
                        Text="{Binding Genres}"
                        Margin="0,0,0,8"/>

                <ScrollViewer Height="180"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,8">
                    <TextBlock Text="{Binding Overview}"
                            Foreground="#EAEAEA"
                            TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Cast -->
                <TextBlock Text="Cast"
                        Foreground="#EAEAEA"
                        FontWeight="SemiBold"
                        Margin="0,4,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding TopCast}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#242424"
                                        CornerRadius="16"
                                        Padding="10,4"
                                        Margin="0,0,8,0">
                                    <TextBlock Foreground="#EAEAEA"
                                            Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Crew -->
                <TextBlock Text="Crew"
                        Foreground="#EAEAEA"
                        FontWeight="SemiBold"
                        Margin="0,4,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding KeyCrew}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#242424"
                                        CornerRadius="16"
                                        Padding="10,4"
                                        Margin="0,0,8,0">
                                    <TextBlock Foreground="#EAEAEA"
                                            Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,0">
                    <Button x:Name="PlayBtn"
                            Content="▶ Play"
                            Width="140"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="#0A84FF"
                            Foreground="White"
                            Click="PlayBtn_Click"/>
                    <Button Content="Link File…"
                            Width="120"
                            Height="36"
                            Margin="0,0,12,0"
                            Click="LinkFile_Click"/>
                    <Button Content="Close"
                            Width="100"
                            Height="36"
                            Click="Close_Click"/>
                </StackPanel>
                <TextBlock x:Name="FileNote"
                        Foreground="#9E9E9E"
                        FontSize="12"
                        Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
