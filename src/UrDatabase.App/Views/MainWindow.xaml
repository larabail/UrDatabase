<Window x:Class="UrDatabase.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UrDatabase - Hello World" Height="300" Width="500">
    <Grid>
        <StackPanel Margin="16">
            <TextBlock Text="Hello, UrDatabase!" FontSize="24" Margin="0,0,0,12"/>
            <TextBlock Text="If you can see this window, WPF is working on your machine."/>
            <Button Content="Close" Width="100" Margin="0,16,0,0" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
