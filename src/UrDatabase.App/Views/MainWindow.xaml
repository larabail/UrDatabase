<Window x:Class="UrDatabase.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="clr-namespace:UrDatabase.Controls"
        xmlns:conv="clr-namespace:UrDatabase.Converters"
        Title="UrDatabase"
        Width="1400"
        Height="900"
        Background="#0F0F10"
        WindowStartupLocation="CenterScreen">
    <!-- ===== All resources used below are declared here ===== -->
    <Window.Resources>
        <!-- Converter -->
        <conv:EqualsConverter x:Key="EqualsConverter"/>

        <!-- Basic colors -->
        <SolidColorBrush x:Key="TextBrush"
                         Color="#EAEAEA"/>
        <SolidColorBrush x:Key="ChipBg"
                         Color="#262626"/>
        <SolidColorBrush x:Key="ChipBorder"
                         Color="#3A3A3A"/>
        <SolidColorBrush x:Key="ChipActive"
                         Color="#0A84FF"/>

        <!-- Reusable styles -->
        <Style x:Key="DarkText"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="DarkButton"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource ChipBg}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource ChipBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="Margin"
                    Value="6,6,0,6"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="ChipToggle"
               TargetType="ToggleButton">
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource ChipBg}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource ChipBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="12,6"/>
            <Setter Property="Margin"
                    Value="6,6,0,6"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource ChipActive}"/>
                    <Setter Property="BorderBrush"
                            Value="{StaticResource ChipActive}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- Top bar -->
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Search"
                               Style="{StaticResource DarkText}"
                               Margin="0,0,0,6"/>
                    <TextBox Width="480"
                             x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Style="{StaticResource DarkButton}"
                            Content="Scan Folders"
                            Click="ScanButton_Click"/>
                    <!-- Keep Settings for now; you can remove it -->
                    <Button Style="{StaticResource DarkButton}"
                            Content="Settings"
                            Click="Settings_Click"/>
                </StackPanel>
            </Grid>

            <!-- Genre chips (with visual selection) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Genres}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChipToggle}"
                                          Content="{Binding}"
                                          Click="GenreChip_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- SEARCH RESULTS (flat) -->
                <StackPanel x:Name="SearchPanel"
                            Visibility="Collapsed">
                    <ItemsControl ItemsSource="{Binding FlatResults}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,0,6,12"
                                            Width="120">
                                    <ctrls:PosterCard SourcePath="{Binding PosterPath}"
                                                      Width="120"
                                                      Height="175"/>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource DarkText}"
                                               TextWrapping="Wrap"
                                               Margin="2,6,2,0"
                                               FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ALL GENRES (grouped with horizontal scrollers) -->
                <StackPanel x:Name="GroupPanel"
                            Visibility="Visible">
                    <ItemsControl ItemsSource="{Binding VisibleGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,22">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource DarkText}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,8"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="6,0,6,0"
                                                                Width="120">
                                                        <ctrls:PosterCard SourcePath="{Binding PosterPath}"
                                                                          Width="120"
                                                                          Height="175"/>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource DarkText}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="2,6,2,0"
                                                                   FontSize="12"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- SINGLE GENRE (vertical flow) -->
                <StackPanel x:Name="SingleGenrePanel"
                            Visibility="Collapsed">
                    <TextBlock Text="{Binding SelectedGenre}"
                               Style="{StaticResource DarkText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="6,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding SingleGenreItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,0,6,12"
                                            Width="120">
                                    <ctrls:PosterCard SourcePath="{Binding PosterPath}"
                                                      Width="120"
                                                      Height="175"/>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource DarkText}"
                                               TextWrapping="Wrap"
                                               Margin="2,6,2,0"
                                               FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
