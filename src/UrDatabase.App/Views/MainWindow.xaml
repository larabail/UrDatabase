<Window x:Class="UrDatabase.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UrDatabase"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F10">
    <Window.Resources>
        <!-- Simple dark styles with explicit keys (no implicit lookup) -->
        <Style x:Key="DarkButton"
                TargetType="Button">
            <Setter Property="Foreground"
                    Value="#EAEAEA"/>
            <Setter Property="Background"
                    Value="#262626"/>
            <Setter Property="BorderBrush"
                    Value="#3A3A3A"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="Margin"
                    Value="6,6,0,6"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>
        <Style x:Key="DarkText"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#EAEAEA"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Top bar -->
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Search"
                            Style="{StaticResource DarkText}"
                            Margin="0,0,0,6"/>
                    <TextBox Width="400"
                            x:Name="SearchBox"
                            TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                    <Button Style="{StaticResource DarkButton}"
                            Content="Scan Folders"
                            Click="ScanButton_Click"/>
                    <Button Style="{StaticResource DarkButton}"
                            Content="Settings"
                            Click="Settings_Click"/>
                </StackPanel>
            </Grid>

            <!-- Genre “chips” as plain buttons (no converters) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Genres}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DarkButton}"
                                    Content="{Binding}"
                                    Click="GenreChip_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Groups list (each with a horizontal scroller of poster placeholders for now) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- SEARCH RESULTS (flat, no genres) -->
                <StackPanel x:Name="SearchPanel"
                        Visibility="Collapsed">
                    <ItemsControl ItemsSource="{Binding FlatResults}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,0,6,12"
                                        Width="120">
                                    <!-- If you use PosterCard, keep it; else keep the placeholder Border -->
                                    <!-- <ctrls:PosterCard SourcePath="{Binding PosterPath}" Width="120" Height="175"/> -->
                                    <Border CornerRadius="18"
                                            Background="#1E1E1E"
                                            Height="175"/>
                                    <TextBlock Text="{Binding Title}"
                                            Foreground="#EAEAEA"
                                               TextWrapping="Wrap"
                                            Margin="2,6,2,0"
                                            FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- GROUPED BY GENRE (shown only when not searching) -->
                <StackPanel x:Name="GroupPanel"
                        Visibility="Visible">
                    <ItemsControl ItemsSource="{Binding VisibleGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,22">
                                    <TextBlock Text="{Binding Name}"
                                            Foreground="#EAEAEA"
                                               FontSize="18"
                                            FontWeight="SemiBold"
                                            Margin="6,0,0,8"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="6,0,6,0"
                                                            Width="120">
                                                        <!-- <ctrls:PosterCard SourcePath="{Binding PosterPath}" Width="120" Height="175"/> -->
                                                        <Border CornerRadius="18"
                                                                Background="#1E1E1E"
                                                                Height="175"/>
                                                        <TextBlock Text="{Binding Title}"
                                                                Foreground="#EAEAEA"
                                                                   TextWrapping="Wrap"
                                                                Margin="2,6,2,0"
                                                                FontSize="12"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
