<Window x:Class="UrDatabase.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UrDatabase" Height="600" Width="900">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="8">
            <TextBox Name="SearchBox" Width="400" Margin="0,0,8,0" />
            <Button Name="ScanButton" Width="120" Content="Scan Folders" />
        </StackPanel>

        <ListView Name="MovieList" Margin="8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="340"/>
                    <GridViewColumn Header="Year" DisplayMemberBinding="{Binding Year}" Width="80"/>
                    <GridViewColumn Header="Genres" DisplayMemberBinding="{Binding Genres}" Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="StatusText" Text="Ready." />
            </StatusBarItem>
        </StatusBar>
    </DockPanel>
</Window>
