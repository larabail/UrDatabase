<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UrDatabase.Views.TmdbMatchWindow"
        Title="Which film is this?"
        Width="720"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F10">
    <Grid Margin="20"
          RowDefinitions="Auto,Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0"
                   Foreground="#9E9E9E"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="UrDatabase matched this film to TMDB by its title. Search for the right one and choose it, and the poster, plot, cast and crew will all come from that film instead."/>

        <!-- The title is pre-filled and editable: what the catalogue calls a film is often the
             reason the search went wrong, so the fix usually starts by rewording it. -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,10,Auto"
              Margin="0,0,0,12">
            <TextBox x:Name="QueryBox"
                     Grid.Column="0"
                     Watermark="Film title"
                     KeyDown="QueryBox_KeyDown"/>
            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Content="Search"
                    Width="100"
                    HorizontalContentAlignment="Center"
                    Click="Search_Click"/>
        </Grid>

        <ListBox x:Name="ResultsList"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionChanged="Results_SelectionChanged"
                 DoubleTapped="Results_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="70,14,*"
                          Margin="0,6">
                        <Border Grid.Column="0"
                                Width="70"
                                Height="105"
                                CornerRadius="6"
                                Background="#1E1E1E"
                                ClipToBounds="True">
                            <Image Source="{Binding Poster}"
                                   Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding OriginalTitle}"
                                       IsVisible="{Binding HasOriginalTitle}"
                                       Foreground="#9E9E9E"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding YearLabel}"
                                       Foreground="#CFCFCF"
                                       FontSize="12"
                                       Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding Overview}"
                                       Foreground="#9E9E9E"
                                       FontSize="12"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Foreground="#9E9E9E"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="100"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>
            <Button x:Name="ChooseButton"
                    Content="Use this film"
                    Width="140"
                    HorizontalContentAlignment="Center"
                    Background="#0A84FF"
                    Foreground="White"
                    IsEnabled="False"
                    Click="Choose_Click"/>
        </StackPanel>
    </Grid>
</Window>
