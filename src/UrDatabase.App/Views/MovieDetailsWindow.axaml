<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="UrDatabase.Views.MovieDetailsWindow"
        Title="Details"
        Width="1000"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0C">
    <Grid>
        <!-- Backdrop -->
        <Grid>
            <Image x:Name="BackdropImage"
                   Stretch="UniformToFill"
                   Opacity="0.35"/>
            <!-- gradient to darken bottom -->
            <Rectangle>
                <Rectangle.Fill>
                    <!-- Avalonia gradient points are relative, so they are given as percentages. -->
                    <LinearGradientBrush StartPoint="0%,0%"
                                         EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#CC000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Foreground content -->
        <Grid Margin="24" ColumnDefinitions="250,24,*">

            <!-- Poster -->
            <Border Grid.Column="0"
                    CornerRadius="18"
                    Background="#1E1E1E"
                    Padding="4"
                    Width="250"
                    Height="375"
                    VerticalAlignment="Top"
                    ClipToBounds="True">
                <Image x:Name="PosterImage"
                       Stretch="UniformToFill"/>
            </Border>

            <!-- Text + actions -->
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Top">
                <TextBlock Text="{Binding Title}"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,12">
                    <Border Background="#2A2A2A"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            IsVisible="{Binding Year, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Foreground="#EAEAEA"
                                   Text="{Binding Year}"/>
                    </Border>
                    <Border Background="#2A2A2A"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            IsVisible="{Binding Runtime, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Foreground="#EAEAEA"
                                   Text="{Binding Runtime, StringFormat='{}{0} min'}"/>
                    </Border>
                    <!-- Hidden entirely when OMDb has no rating, or no OMDb key is configured. -->
                    <Border Background="#0A84FF"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            IsVisible="{Binding ImdbRating, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Foreground="White"
                                   Text="{Binding ImdbRating, StringFormat='IMDb {0:0.0}'}"/>
                    </Border>
                </StackPanel>

                <TextBlock Foreground="#CFCFCF"
                           Text="{Binding Genres}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <ScrollViewer Height="150"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,8">
                    <TextBlock Text="{Binding Overview}"
                               Foreground="#EAEAEA"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Cast -->
                <TextBlock Text="Cast"
                           Foreground="#EAEAEA"
                           FontWeight="SemiBold"
                           Margin="0,4,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding TopCast}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#242424"
                                        CornerRadius="16"
                                        Padding="10,4"
                                        Margin="0,0,8,0">
                                    <TextBlock Foreground="#EAEAEA"
                                               Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Crew -->
                <TextBlock Text="Crew"
                           Foreground="#EAEAEA"
                           FontWeight="SemiBold"
                           Margin="0,4,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding KeyCrew}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#242424"
                                        CornerRadius="16"
                                        Padding="10,4"
                                        Margin="0,0,8,0">
                                    <TextBlock Foreground="#EAEAEA"
                                               Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,0">
                    <Button x:Name="PlayBtn"
                            Content="▶ Play"
                            Width="140"
                            Height="36"
                            Margin="0,0,12,0"
                            HorizontalContentAlignment="Center"
                            Background="#0A84FF"
                            Foreground="White"
                            Click="PlayBtn_Click"/>
                    <Button Content="Link File…"
                            Width="120"
                            Height="36"
                            Margin="0,0,12,0"
                            HorizontalContentAlignment="Center"
                            Click="LinkFile_Click"/>
                    <Button Content="Close"
                            Width="100"
                            Height="36"
                            HorizontalContentAlignment="Center"
                            Click="Close_Click"/>
                </StackPanel>
                <TextBlock x:Name="FileNote"
                           Foreground="#9E9E9E"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <!-- Attribution required by the TMDB API terms; OMDb credited as the rating source. -->
                <TextBlock Foreground="#7A7A7E"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="Metadata and artwork from TMDB. This product uses the TMDB API but is not endorsed or certified by TMDB. IMDb rating retrieved from the OMDb API; neither IMDb nor OMDb endorses this application."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
