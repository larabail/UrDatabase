<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UrDatabase.Views.MessageBoxWindow"
        Title="UrDatabase"
        SizeToContent="Height"
        Width="440"
        CanResize="False"
        Background="#0F0F10"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText"
                   Foreground="#EAEAEA"
                   TextWrapping="Wrap"
                   MaxHeight="320"/>
        <StackPanel x:Name="Buttons"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <!-- Hidden unless this is a question. Ordered cancel-then-confirm so the safe
                 answer is the one nearest the pointer's resting place. -->
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="90"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,10,0"
                    IsVisible="False"
                    Click="Cancel_Click"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="90"
                    HorizontalContentAlignment="Center"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
