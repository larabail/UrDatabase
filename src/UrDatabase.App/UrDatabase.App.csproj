<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>UrDatabase.App</AssemblyName>
    <RootNamespace>UrDatabase</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/UrDatabase.ico</ApplicationIcon>
    <!-- Dapper and System.Text.Json rely on reflection, so trimming stays off. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    API keys baked in at build time. CI passes them from repository secrets:
      dotnet publish ... -p:TmdbApiKey=$TMDB_API_KEY -p:OmdbApiKey=$OMDB_API_KEY -p:UrActorApiKey=$URACTOR_API_KEY
    All default to empty so a local build with no keys still compiles, runs and tests.
    Never commit a value here.
  -->
  <PropertyGroup>
    <TmdbApiKey Condition="'$(TmdbApiKey)' == ''"></TmdbApiKey>
    <OmdbApiKey Condition="'$(OmdbApiKey)' == ''"></OmdbApiKey>
    <UrActorApiKey Condition="'$(UrActorApiKey)' == ''"></UrActorApiKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DistributionChannel</_Parameter1>
      <_Parameter2>$(DistributionChannel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TmdbApiKey</_Parameter1>
      <_Parameter2>$(TmdbApiKey)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OmdbApiKey</_Parameter1>
      <_Parameter2>$(OmdbApiKey)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UrActorApiKey</_Parameter1>
      <_Parameter2>$(UrActorApiKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
    <PackageReference Include="Dapper" Version="2.1.28" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/UrDatabase.ico" />
    <!-- Tracked template. Always shipped so a clean checkout has working defaults. -->
    <Content Include="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Untracked local override. The condition keeps the build green when it is absent. -->
    <Content Include="appsettings.json" Condition="'$(DistributionChannel)' != 'MicrosoftStore' and Exists('$(MSBuildProjectDirectory)/appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data/schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrDatabase.Tests" />
  </ItemGroup>

  <Target Name="ValidateDistributionChannel" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DistributionChannel)' != 'Standalone' and '$(DistributionChannel)' != 'MicrosoftStore'"
           Text="DistributionChannel must be Standalone or MicrosoftStore." />
  </Target>

  <Target Name="WriteStoreDistribution" AfterTargets="Publish" Condition="'$(DistributionChannel)' == 'MicrosoftStore'">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' or '$(SelfContained)' != 'true'"
           Text="MicrosoftStore publishing requires --runtime win-x64 --self-contained true." />
    <WriteLinesToFile File="$(PublishDir)distribution-channel.txt" Lines="$(DistributionChannel)" Overwrite="true" />
  </Target>
</Project>
