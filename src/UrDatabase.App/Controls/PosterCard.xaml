<UserControl x:Class="UrDatabase.Controls.PosterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="120" MinHeight="175">
    <Border CornerRadius="18" Background="#1E1E1E" Padding="4" SnapsToDevicePixels="True">
        <Grid>
            <Image x:Name="Poster" Stretch="UniformToFill" ClipToBounds="True" />
            <Border CornerRadius="18" BorderBrush="#333" BorderThickness="1"/>
        </Grid>
    </Border>
</UserControl>
