<UserControl x:Class="UrDatabase.Controls.PosterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="120"
        MinHeight="175">
    <Border CornerRadius="18"
            Background="#1E1E1E"
            Padding="4"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- Bind directly to the DP on the UserControl (no code-behind needed) -->
            <Image Stretch="UniformToFill"
                   ClipToBounds="True"
                   Source="{Binding SourcePath, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Border CornerRadius="18"
                    BorderBrush="#333"
                    BorderThickness="1"/>
        </Grid>
    </Border>
</UserControl>
